# E.D.A.I. deployment — environment template
# Copy to deployment/.env (gitignored) and fill in. Never commit a real key.
#
# The scripts read these two variables (they prompt if unset).
# The scripts do not load dotenv; export them in your shell or use a loader.
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=<YOUR_PRIVATE_KEY>

# Test on testnet first. The deploy script as written targets mainnet.
HEDERA_NETWORK=testnet

# Written by deploy-edai.js into deployment-info.json after a run.
GUARDIAN_TOKEN_ID=
VERIFICATION_TOPIC_ID=
COMPLIANCE_TOPIC_ID=

LOG_LEVEL=info
